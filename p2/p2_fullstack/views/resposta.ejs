<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Status do login</title>
    <link rel="stylesheet" href="/p2_fullstack/resposta-template.css" />
  </head>
  <body class="resposta-page">
    <div class="box <%= sucesso ? 'ok' : 'fail' %>">
      <div class="status"><%= sucesso ? '✓' : '✕' %></div>
      <h1><%= titulo %></h1>
      <p><%= mensagem %></p>
      <nav class="resposta-nav">
        <a href="/lembrete">Voltar ao login</a>
      </nav>
    </div>
  </body>
</html>
