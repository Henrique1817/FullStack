<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Status do login</title>
    <style>
      :root {
        --ok: #22c55e;
        --fail: #ef4444;
        --bg: #0f172a;
        --card: rgba(255, 255, 255, 0.06);
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(160deg, #1e293b 0%, var(--bg) 45%, #1a1030 100%);
        font-family: "Segoe UI", system-ui, sans-serif;
        color: #e6eef8;
      }
      .box {
        text-align: center;
        padding: 2.5rem 2rem;
        max-width: 420px;
        background: var(--card);
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
      }
      .status {
        font-size: 3rem;
        line-height: 1;
        margin-bottom: 0.75rem;
      }
      h1 {
        margin: 0 0 0.75rem;
        font-size: 1.35rem;
      }
      p {
        margin: 0.5rem 0;
        line-height: 1.5;
        color: #cbd5e1;
      }
      .ok .status {
        color: var(--ok);
      }
      .fail .status {
        color: var(--fail);
      }
      nav {
        margin-top: 1.75rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
      }
      nav a {
        color: #7dd3fc;
        text-decoration: none;
      }
      nav a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="box <%= sucesso ? 'ok' : 'fail' %>">
      <div class="status"><%= sucesso ? '✓' : '✕' %></div>
      <h1><%= titulo %></h1>
      <p><%= mensagem %></p>
      <% if (sucesso && nomeUsuario) { %>
        <p><strong>Olá, <%= nomeUsuario %>!</strong></p>
      <% } %>
      <nav>
        <a href="/login">Voltar ao login</a>
        <a href="/primeiroSemetres/projects.html">Projetos</a>
      </nav>
    </div>
  </body>
</html>
